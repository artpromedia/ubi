{
  "extends": "@ubi/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ubi/ui": ["../../packages/ui/src"],
      "@ubi/ui/*": ["../../packages/ui/src/*"],
      "@ubi/utils": ["../../packages/utils/src"],
      "@ubi/utils/*": ["../../packages/utils/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
