# Marketing destinations. HTTPS only; unset or http ⇒ launch-status copy instead of a link
# (DestinationLink). Confirm every URL belongs to the real UBI product before setting it.
UBI_RIDER_URL=
UBI_DRIVER_URL=
UBI_IOS_STORE_URL=
UBI_ANDROID_STORE_URL=
UBI_DRIVER_IOS_STORE_URL=
UBI_DRIVER_ANDROID_STORE_URL=
UBI_PRIVACY_URL=
UBI_TERMS_URL=
UBI_FLEET_CONTACT_URL=
UBI_HELP_URL=
# Safety line on /help. Shown only when set.
UBI_SUPPORT_PHONE=

# Server-side reads of config-service (never exposed to the browser).
UBI_CONFIG_BASE_URL=http://127.0.0.1:3010
UBI_CONFIG_SERVICE_TOKEN=

# user-service driver requirements (GET /v1/kyc/requirements).
UBI_USER_BASE_URL=http://127.0.0.1:4001

# Shared secret for POST /api/revalidate (config-service's marketing consumer
# presents it as a bearer token). Unset ⇒ the route answers 503.
UBI_REVALIDATE_SECRET=

# Analytics (browser). Events fire only after consent (cookie `ubi_consent`
# containing `analytics`). PostHog is the repo's existing vendor; leave unset to drop events.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
