# UBI Production Environment Configuration
# Copy this file to .env and fill in the values
#
# Every value here is a PLACEHOLDER. `scripts/deploy.sh preflight` refuses a
# .env that still carries a CHANGE_ME value, a required secret shorter than
# 32 characters, or two trust-boundary secrets with the same value. The full
# service x variable matrix is docs/ops/DEPLOY_ENV_MATRIX.md.
#
# Generate secrets with:   openssl rand -base64 48 | tr -d '\n'
# Generate a 32-byte key:  openssl rand -base64 32   (TRIP_ACCESS_DELIVERY_KEY)

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
DOMAIN=ubi.africa
API_DOMAIN=api.ubi.africa
ADMIN_DOMAIN=admin.ubi.africa
# Supplier webhooks ingress (straight to travel-service; never the client API
# gateway). Register https://$WEBHOOKS_DOMAIN/v1/travel/webhooks/<supplierId>.
WEBHOOKS_DOMAIN=hooks.ubi.africa

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=ubi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=ubi_production

# =============================================================================
# REDIS
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# =============================================================================
# JWT & AUTH
# =============================================================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_JWT_SECRET_HERE
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_HERE

# =============================================================================
# INTERNAL TRUST BOUNDARY (required — see docs/security/INTERNAL_IDENTITY.md)
# =============================================================================
# docker compose refuses to start with any of these empty, and the services
# refuse to boot in production without them. Generate each with:
#   openssl rand -base64 64
# Gateway-signed identity context (x-ubi-identity): api-gateway signs;
# user-service, payment-service, ask-service, travel-service and
# fleet-service verify. Must differ from JWT_SECRET.
UBI_IDENTITY_SECRET=CHANGE_ME_UBI_IDENTITY_SECRET_HERE
# Ride-service HMAC context (x-auth-signature): api-gateway, ask-service and
# travel-service sign; ride-service and delivery-service verify. Rotate by
# setting "<new>,<old>" on the verifiers first.
RIDE_INTERNAL_CONTEXT_SECRET=CHANGE_ME_RIDE_INTERNAL_CONTEXT_SECRET_HERE
# Shared service-to-service key (X-Service-Key): payment-service's
# /v1/finance/* (travel, business budgets, delivery returns), ride-service ->
# delivery-service hand-off, delivery-service -> payment-service, food,
# support, growth, config, notification and realtime-gateway service routes.
INTERNAL_SERVICE_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY_HERE

# =============================================================================
# RIDE-SERVICE SIGNING KEYS (required)
# =============================================================================
# Signs every quote; ride-service refuses to start without >= 32 characters.
RIDE_QUOTE_SIGNING_SECRET=
# Encrypts pickup PINs at rest. Keep it separate from
# RIDE_INTERNAL_CONTEXT_SECRET (the fallback), or rotating that secret makes
# stored PINs unreadable. Never rotate it while trips are in progress.
RIDE_PIN_VAULT_SECRET=

# =============================================================================
# PER-SURFACE SERVICE KEYS (required; >= 32 characters, each its own value)
# =============================================================================
# One key per caller -> callee surface, so one leak never opens another route.
# Each is compared in constant time; unset or short closes the route.
# ride-service -> user-service /internal/driver-profiles
DRIVER_PROFILE_RIDE_SERVICE_KEY=
# ask-service -> user-service action grants and mandate runs
AI_GRANTS_SERVICE_KEY=
# ask-service -> travel-service /internal/ask (background order reads)
TRAVEL_ASK_SERVICE_KEY=
# ride-service -> fleet-service (contract A, vehicle lookups)
FLEET_SERVICE_KEY=
# fleet-service -> ride-service /internal/fleet (contract A, occupancy/swaps)
FLEET_RIDE_SERVICE_KEY=
# payment-service -> fleet-service settlement inputs (contract B)
FLEET_PAYMENT_SERVICE_KEY=
# ride-service -> delivery-service uses DELIVERY_SERVICE_KEY, which the
# compose file sets to INTERNAL_SERVICE_KEY (delivery-service authenticates
# the hand-off with its INTERNAL_SERVICE_KEY). Nothing to set here.

# =============================================================================
# GUEST PASSENGER TRIP LINK (optional — empty keeps it closed)
# =============================================================================
# Seals the passenger's trip link from ride-service to notification-service
# (AES-256-GCM). Standard base64 of exactly 32 random bytes, named by a kid.
# Empty: book-for-another-adult is refused and no link is ever sent.
TRIP_ACCESS_DELIVERY_KEY=
TRIP_ACCESS_DELIVERY_KID=
# Rotation only: the previous key/kid, read by notification-service so links
# sealed just before a rotation still open.
TRIP_ACCESS_DELIVERY_KEY_PREVIOUS=
TRIP_ACCESS_DELIVERY_KID_PREVIOUS=

# =============================================================================
# TRUSTED PROXIES (optional — the defaults match docker-compose.prod.yml)
# =============================================================================
# Only these addresses may say who the client is (X-Forwarded-For). The
# defaults are Caddy (172.28.0.10) for the gateway, and Caddy + the gateway
# (172.28.0.11) for the services behind it. Override only if a load balancer
# is put in front of Caddy (then add its address to GATEWAY_TRUSTED_PROXIES).
# GATEWAY_TRUSTED_PROXIES=172.28.0.10
# RIDE_TRUSTED_PROXIES=172.28.0.10,172.28.0.11
# PAYMENT_TRUSTED_PROXIES=172.28.0.10,172.28.0.11
# DELIVERY_TRUSTED_PROXIES=172.28.0.10,172.28.0.11
# NOTIFICATION_TRUSTED_PROXIES=172.28.0.10,172.28.0.11

# =============================================================================
# SWEEP INTERVALS (optional — milliseconds; the defaults match the code)
# =============================================================================
# FLEET_SETTLEMENT_SWEEP_INTERVAL_MS=3600000
# BUSINESS_PAYOUT_SWEEP_INTERVAL_MS=300000
# TRANSFER_SWEEP_INTERVAL_MS=30000
# SOS_SWEEP_INTERVAL_MS=30000
# BITES_ISSUE_SWEEP_INTERVAL_MS=60000
# RIDE_MP_SWEEP_INTERVAL_MS=1000

# =============================================================================
# OBJECT STORAGE (MinIO)
# =============================================================================
MINIO_ROOT_USER=ubi_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_HERE
# Delivery custody proofs: a PRIVATE bucket and a MinIO user limited to it,
# created by `docker compose --profile tools run --rm minio-init`. Empty
# keys: proof uploads are refused and delivery-service is never "ready" in
# production (fail closed) — set them before marketplace delivery is used.
PROOF_STORAGE_BUCKET=ubi-delivery-proofs
PROOF_STORAGE_REGION=us-east-1
PROOF_STORAGE_ACCESS_KEY=
PROOF_STORAGE_SECRET_KEY=

# =============================================================================
# USER-SERVICE IDENTITY (optional — each surface refuses while empty)
# =============================================================================
# Peppers the OTP cache keys (recommended).
IDENTITY_OTP_PEPPER=
# Scheduled identity jobs / telco SIM-swap webhook (>= 32 characters).
IDENTITY_JOB_SERVICE_KEY=
TELCO_SIM_SWAP_SECRET=
# Face match / liveness provider.
IDENTITY_FACE_PROVIDER_URL=
IDENTITY_FACE_PROVIDER_KEY=

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD_HERE

# =============================================================================
# APPLICATION
# =============================================================================
IMAGE_TAG=latest
LOG_LEVEL=info

# =============================================================================
# PAYMENT RAILS (optional — an empty rail is unavailable and fails closed)
# =============================================================================
# Canonical ledger rails (services/payment-service/src/ledger/providers.ts)
NIP_BASE_URL=
NIP_API_KEY=
NIP_WEBHOOK_SECRET=
TOPUP_BASE_URL=
TOPUP_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack (Africa)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# M-Pesa (Kenya)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# =============================================================================
# NOTIFICATION PROVIDERS (Optional - configure as needed)
# =============================================================================
# Firebase (Push Notifications): the service account JSON, on one line
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Africa's Talking (SMS)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@ubi.africa

# =============================================================================
# THIRD-PARTY SERVICES (Optional)
# =============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=

# Google Maps API (ride-service: measured routes instead of estimates)
GOOGLE_MAPS_API_KEY=

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=ubi-backups
