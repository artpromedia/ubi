{
  "$source": "packages/design-tokens (base, semantic, dark) as used on the board",
  "font": {
    "heading": "Poppins 600/700",
    "body": "Inter 400/500/600/700",
    "mono": "ui-monospace (plates, refs, PNRs)"
  },
  "grid": "4px",
  "radius": {
    "chip": 999,
    "control": 12,
    "card": 14,
    "cardLg": 16,
    "sheet": 24,
    "sheetAndroid": 28
  },
  "targets": {
    "ios": "44pt",
    "android": "48dp",
    "primaryButton": "54-56px"
  },
  "light": {
    "bg": "#FFFFFF",
    "bg2": "#F5F5F5",
    "ink": "#191414",
    "text2": "#666666",
    "text3": "#999999",
    "border": "#E5E5E5",
    "divider": "#F0F0F0",
    "move": "#1DB954",
    "moveInk": "#148F3D",
    "link": "#18A349",
    "moveTint": "#E8F8EE",
    "warn": "#F5A623",
    "warnTint": "#FEF6E8",
    "warnInk": "#B8860B",
    "error": "#E53E3E",
    "errorTint": "#FDE8E8",
    "errorInk": "#C53030",
    "travel": "#3182CE",
    "travelTint": "#EBF4FF",
    "travelInk": "#2B6CB0",
    "bites": "#FF7545",
    "bitesTint": "#FFF1EB",
    "bitesInk": "#C2410C",
    "send": "#10AEBA",
    "sendTint": "#E6F7F8",
    "sendInk": "#0E7F88"
  },
  "dark": {
    "bg": "#0A0A0A",
    "bg2": "#171717",
    "card": "#1A1A1A",
    "border": "#262626",
    "border2": "#404040",
    "text": "#FFFFFF",
    "text2": "#A3A3A3",
    "text3": "#737373",
    "ok": "#22D66A",
    "okTint": "rgba(34,214,106,.15)",
    "warn": "#FBB034",
    "warnTint": "rgba(251,176,52,.15)",
    "error": "#F87171",
    "errorTint": "rgba(248,113,113,.15)",
    "info": "#63B3ED",
    "infoTint": "rgba(99,179,237,.15)",
    "primaryButton": "#1DB954 on #191414 text",
    "disabledPrimary": "rgba(29,185,84,.4) with #737373 text"
  },
  "statusBadges": {
    "searching": "warnTint/warnInk",
    "assigned": "travelTint/travelInk",
    "inTrip": "moveTint/moveInk",
    "completed": "bg2/text2",
    "cancelled": "errorTint/errorInk",
    "safetyHold": "error/#fff"
  }
}