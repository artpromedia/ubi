{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.development",
    ".env.production"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "MPESA_API_URL",
    "MTN_MOMO_API_URL",
    "AIRTEL_MONEY_API_URL",
    "TELEBIRR_API_URL",
    "ORANGE_MONEY_API_URL"
  ],
  "globalPassThroughEnv": [
    "GITHUB_TOKEN",
    "NPM_TOKEN",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "MARKETING_REVALIDATE_URL",
    "MARKETING_REVALIDATE_SECRET",
    "UBI_CONFIG_BASE_URL",
    "UBI_CONFIG_SERVICE_TOKEN",
    "UBI_USER_BASE_URL",
    "UBI_REVALIDATE_SECRET",
    "UBI_RIDER_URL",
    "UBI_DRIVER_URL",
    "UBI_IOS_STORE_URL",
    "UBI_ANDROID_STORE_URL",
    "UBI_DRIVER_IOS_STORE_URL",
    "UBI_DRIVER_ANDROID_STORE_URL",
    "UBI_PRIVACY_URL",
    "UBI_TERMS_URL",
    "UBI_FLEET_CONTACT_URL",
    "UBI_HELP_URL",
    "UBI_SUPPORT_PHONE",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "PW_CHROMIUM_PATH",
    "UBI_SITE_URL",
    "RIDE_SERVICE_URL",
    "FLEET_SERVICE_URL",
    "FLEET_PAYMENT_SERVICE_KEY",
    "AI_GRANTS_SERVICE_KEY",
    "TRAVEL_ASK_SERVICE_KEY",
    "TRANSFER_SWEEP_INTERVAL_MS",
    "NOTIFY_TEST_DATABASE_URL",
    "NOTIFY_TEST_REDIS_URL",
    "PORT",
    "LOG_LEVEL",
    "SERVICE_VERSION",
    "npm_package_version",
    "NEXT_RUNTIME",
    "TZ",
    "JWT_SECRET",
    "INTERNAL_SERVICE_KEY",
    "INTERNAL_API_KEY",
    "SERVICE_API_KEY",
    "VALID_SERVICE_API_KEYS",
    "NOTIFICATION_SERVICE_API_KEY",
    "UBI_IDENTITY_*",
    "RIDE_INTERNAL_CONTEXT_SECRET",
    "DRIVER_PROFILE_RIDE_SERVICE_KEY",
    "DRIVER_PROFILE_ASK_SERVICE_KEY",
    "FLEET_SERVICE_KEY",
    "FLEET_RIDE_SERVICE_KEY",
    "TRIP_ACCESS_DELIVERY_*",
    "PASSENGER_TRIP_LINK_BASE_URL",
    "*_TRUSTED_PROXIES",
    "USER_SERVICE_URL",
    "PAYMENT_SERVICE_URL",
    "NOTIFICATION_SERVICE_URL",
    "CONFIG_SERVICE_URL",
    "TRAVEL_SERVICE_URL",
    "SUPPORT_SERVICE_URL",
    "PROMOTIONS_SERVICE_URL",
    "PAYMENT_TRAVEL_PATH",
    "LEDGER_REMEDY_PATH",
    "PROXY_TIMEOUT",
    "FLEET_SETTLEMENT_SWEEP_INTERVAL_MS",
    "BUSINESS_PAYOUT_SWEEP_INTERVAL_MS",
    "BITES_ISSUE_SWEEP_INTERVAL_MS",
    "SOS_SWEEP_INTERVAL_MS",
    "AI_GRANT_TTL_SECONDS",
    "IDENTITY_*",
    "TELCO_SIM_SWAP_SECRET",
    "MODEL_*",
    "EMBED_*",
    "MARKETING_MODEL",
    "MARKETING_PROMPT_VERSION",
    "REFERRAL_URL_BASE",
    "APP_URL",
    "API_URL",
    "APP_DEEP_LINK_SCHEME",
    "DEEP_LINK_BASE_URL",
    "SMS_SENDER_ID",
    "ENCRYPTION_KEY",
    "SLOW_QUERY_THRESHOLD_MS",
    "ANALYTICS_ENABLED",
    "POSTHOG_API_KEY",
    "POSTHOG_HOST",
    "SEGMENT_WRITE_KEY",
    "NIP_*",
    "TOPUP_*",
    "AIRTEL_*",
    "FLUTTERWAVE_*",
    "MOMO_*",
    "MPESA_*",
    "MTN_MOMO_*",
    "PAYSTACK_*",
    "AFRICASTALKING_*",
    "FIREBASE_*",
    "SENDGRID_*",
    "TWILIO_*",
    "UBI_API_BASE",
    "UBI_FIXTURES",
    "VITE_API_URL",
    "TEST_API_URL",
    "TEST_DATABASE_URL",
    "TEST_REDIS_URL",
    "TEST_TIMEOUT",
    "TEST_USE_REAL_SERVICES"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx",
        "!**/__tests__/**",
        "!**/coverage/**",
        "!**/.turbo/**"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "out/**"
      ],
      "cache": true,
      "persistent": false
    },
    "build:docker": {
      "dependsOn": ["build"],
      "inputs": ["Dockerfile", "docker/**", "dist/**"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        ".eslintrc.js",
        ".eslintrc.json",
        "eslint.config.mjs"
      ],
      "outputs": [],
      "cache": true
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.ts",
        "**/*.tsx",
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/__tests__/**",
        "jest.config.*",
        "vitest.config.*"
      ],
      "outputs": ["coverage/**"],
      "cache": true,
      "env": ["CI", "NODE_ENV"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/e2e/**",
        "**/playwright/**",
        "**/cypress/**",
        "playwright.config.*",
        "cypress.config.*"
      ],
      "outputs": [
        "playwright-report/**",
        "cypress/screenshots/**",
        "cypress/videos/**"
      ],
      "cache": false,
      "env": [
        "CI",
        "BASE_URL",
        "E2E_BASE_URL",
        "TEST_USER_EMAIL",
        "TEST_USER_PASSWORD"
      ]
    },
    "clean": {
      "cache": false,
      "persistent": false
    },
    "codegen": {
      "dependsOn": ["^codegen"],
      "inputs": [
        "**/*.graphql",
        "**/*.gql",
        "**/openapi.yaml",
        "**/openapi.json",
        "**/schema.prisma",
        "codegen.ts",
        "codegen.yaml",
        "scripts/generate-state-machines.mjs",
        "$TURBO_ROOT$/contracts/state-machines.json"
      ],
      "outputs": [
        "**/generated/**",
        "**/__generated__/**",
        "**/src/generated/**",
        "**/*.generated.ts"
      ],
      "cache": true
    },
    "db:generate": {
      "inputs": ["**/schema.prisma", "**/prisma/schema.prisma"],
      "outputs": ["**/node_modules/.prisma/**"],
      "cache": true
    },
    "db:migrate": {
      "inputs": ["**/prisma/migrations/**"],
      "outputs": [],
      "cache": false
    },
    "db:migrate:dev": {
      "inputs": ["**/schema.prisma", "**/prisma/schema.prisma"],
      "outputs": ["**/prisma/migrations/**"],
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["db:migrate"],
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build", "test", "lint"],
      "outputs": [],
      "cache": false,
      "env": ["AWS_REGION", "AWS_ACCOUNT_ID", "DEPLOY_ENV", "VERCEL_TOKEN"]
    },
    "docker:build": {
      "dependsOn": ["build"],
      "inputs": ["Dockerfile", "docker/**", ".dockerignore"],
      "outputs": [],
      "cache": false
    }
  }
}
