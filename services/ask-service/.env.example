# =============================================================================
# UBI Ask Service — environment
# =============================================================================
# Copy to .env and fill in. Nothing here is a business number: fares, caps,
# currencies and feature flags come from the versioned city config and the
# feature-flag tables, never from this file. `ai_marketplace` stays OFF
# (deny-by-default) until it is enabled per city through config.

# Database (the shared UBI schema; see packages/database)
DATABASE_URL="postgresql://ubi:ubi_dev_password@localhost:5432/ubi_dev?schema=public"

# Redis — per-user rate limiting of the assistant only
REDIS_URL="redis://localhost:6379"

# Service
NODE_ENV="development"
PORT=4013
LOG_LEVEL="info"

# Privately served model + embeddings (OpenAI-compatible vLLM / SGLang).
MODEL_ENDPOINT_URL="http://localhost:8000/v1"
MODEL_NAME="Qwen/Qwen3-30B-A3B-Instruct-2507"
MODEL_REVISION="2507"
MODEL_API_KEY=""
# Unset = the offline lexical embedder.
# EMBED_ENDPOINT_URL="http://localhost:8001/v1"
# EMBED_NAME="Qwen/Qwen3-Embedding-0.6B"
# EMBED_REVISION="0.6b"

# Downstream services
USER_SERVICE_URL="http://localhost:4001"
RIDE_SERVICE_URL="http://localhost:4002"
TRAVEL_SERVICE_URL="http://localhost:4008"
PROMOTIONS_SERVICE_URL="http://localhost:4009"
SUPPORT_SERVICE_URL="http://localhost:4011"

# Shared secret for service-to-service calls (grants, travel, promotions,
# support). Not sent to ride-service, which verifies the signed context below.
INTERNAL_SERVICE_KEY="change-me"

# The ride-service internal-context HMAC key list — the SAME value the API
# gateway and ride-service carry (docs/security/INTERNAL_IDENTITY.md). The
# assistant's marketplace calls go straight to ride-service AS the signed-in
# user, signed with the FIRST key; during a rotation set "new,old" everywhere.
# REQUIRED in production: ask-service refuses to boot without it. Unset in
# development = identity headers go unsigned (development ride-service only).
RIDE_INTERNAL_CONTEXT_SECRET=""

# Integration tests run against a real Postgres; see tests/helpers.ts
ASK_TEST_DATABASE_URL="postgresql://ubi:ubi_dev_password@127.0.0.1:5432/ubi_ask_test"
