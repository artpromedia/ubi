# =============================================================================
# UBI Support Service — environment
# =============================================================================
# Copy to .env and fill in. Nothing here is a business number: SLAs, remedy
# ceilings, dual-control thresholds, the currency and the emergency number all
# come from the versioned city config, never from this file.

# Database (the shared UBI schema; see packages/database)
DATABASE_URL="postgresql://ubi:ubi_dev_password@localhost:5432/ubi_dev?schema=public"

# Redis — only used to stop two workers running the SOS retry sweep at once
REDIS_URL="redis://localhost:6379"

# Service
NODE_ENV="development"
PORT=4011
LOG_LEVEL="info"

# How often the SOS retry sweep runs, in milliseconds
SOS_SWEEP_INTERVAL_MS=30000

# The ledger. Remedies are posted as counter-lines by payment-service; this
# service never writes journal rows itself.
PAYMENT_SERVICE_URL="http://localhost:4003"
# Override only if payment-service mounts the remedy endpoint elsewhere.
# LEDGER_REMEDY_PATH="/v1/finance/remedies"

# Safety notifications (push, with SMS fallback)
NOTIFICATION_SERVICE_URL="http://localhost:4006"

# Shared secret for service-to-service calls
INTERNAL_SERVICE_KEY="change-me"

# Integration tests run against a real Postgres; see tests/helpers.ts
SUPPORT_TEST_DATABASE_URL="postgresql://ubi:ubi_dev_password@127.0.0.1:5432/ubi_support_test"
