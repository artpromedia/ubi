// ===========================================
// 004 — Bites (slice 05, canonical model)
// ===========================================
// Source: docs/launch-readiness/handoff/db/004_bites.sql. Money is bigint minor
// units + currency, ids are text (nanoid), state tables carry version.
//
// COLLISION RESOLUTION (ADR 0001 §8): the handoff DDL names two tables
// `merchants` and `menu_items`, but those names already belong to unrelated
// models — `merchants` is a Send/courier merchant (Merchant, with a deliveries
// relation) and `menu_items` is the legacy Restaurant food model (MenuItem).
// Migrating either onto the Bites shape would break delivery-service and the
// legacy food model. The Bites tables are therefore namespaced `bites_merchants`
// and `bites_menu_items`; every other Bites table keeps its handoff name, since
// none of the rest collide. Non-destructive.

model BitesMerchant {
  id         String    @id
  legalName  String?   @map("legal_name")
  tradeName  String?   @map("trade_name")
  cacRc      String?   @map("cac_rc")
  tin        String?
  status     String
  approvedAt DateTime? @map("approved_at")
  rankScore  Decimal   @default(0) @map("rank_score") @db.Decimal(10, 4)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  kyb     MerchantKyb[]
  outlets Outlet[]
  payouts MerchantPayout[]

  @@index([status])
  @@map("bites_merchants")
}

model MerchantKyb {
  id           String    @id
  merchantId   String    @map("merchant_id")
  checks       Json
  permitFile   String?   @map("permit_file")
  permitExpiry DateTime? @map("permit_expiry") @db.Date
  reviewedBy   String?   @map("reviewed_by")
  decision     String?
  createdAt    DateTime  @default(now()) @map("created_at")

  merchant BitesMerchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("merchant_kyb")
}

model Outlet {
  id          String    @id
  merchantId  String    @map("merchant_id")
  address     String?
  lat         Decimal?  @db.Decimal(10, 7)
  lng         Decimal?  @db.Decimal(10, 7)
  hours       Json?
  pausedUntil DateTime? @map("paused_until")
  open        Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  merchant  BitesMerchant   @relation(fields: [merchantId], references: [id])
  menuItems BitesMenuItem[]
  carts     Cart[]
  orders    BitesOrder[]

  @@index([merchantId, open])
  @@map("outlets")
}

model BitesMenuItem {
  id           String    @id
  outletId     String    @map("outlet_id")
  category     String?
  name         String
  description  String?
  priceMinor   BigInt    @map("price_minor")
  currency     String
  allergens    String[]
  soldOutUntil DateTime? @map("sold_out_until")
  photoRef     String?   @map("photo_ref")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  outlet       Outlet        @relation(fields: [outletId], references: [id])
  optionGroups OptionGroup[]

  @@index([outletId, active])
  @@map("bites_menu_items")
}

model OptionGroup {
  id        String   @id
  itemId    String   @map("item_id")
  name      String
  required  Boolean  @default(false)
  minSelect Int      @default(0) @map("min_select")
  maxSelect Int      @default(1) @map("max_select")
  createdAt DateTime @default(now()) @map("created_at")

  item    BitesMenuItem @relation(fields: [itemId], references: [id])
  options MenuOption[]

  @@index([itemId])
  @@map("option_groups")
}

model MenuOption {
  id              String   @id
  groupId         String   @map("group_id")
  name            String
  priceDeltaMinor BigInt   @default(0) @map("price_delta_minor")
  createdAt       DateTime @default(now()) @map("created_at")

  group OptionGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
  @@map("options")
}

model Cart {
  id            String   @id
  userId        String   @map("user_id")
  outletId      String   @map("outlet_id")
  items         Json
  subtotalMinor BigInt   @map("subtotal_minor")
  currency      String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([userId, outletId])
  @@map("carts")
}

model BitesOrder {
  id              String   @id
  userId          String   @map("user_id")
  outletId        String   @map("outlet_id")
  status          String
  items           Json
  totals          Json
  currency        String
  paymentIntentId String?  @map("payment_intent_id")
  authCaptured    Boolean  @default(false) @map("auth_captured")
  handoverCode    String?  @map("handover_code")
  deliveryCode    String?  @map("delivery_code")
  courierId       String?  @map("courier_id")
  version         Int      @default(1)
